{
  "name": "context-call-control",
  "version": "0.1.0",
  "description": "Reference control plane for context-scoped one-to-one audio calls.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
